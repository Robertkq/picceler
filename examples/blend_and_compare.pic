
# blend_and_compare.pic -- compositing two images together with blend() and
# diff(), and saving each result so you can compare them side by side.
#
# Run from your build directory (see BUILD.md):
#   ./picceler -o blend_and_compare ./examples/blend_and_compare.pic
#   ./blend_and_compare

blue = load_image("../img/blue.png")
white = load_image("../img/white.png")
show_image(blue)
show_image(white)

# blend(a, b, weight) mixes two same-sized images; weight is a's share of
# the result.
mostly_blue = blend(blue, white, 0.75)
mostly_white = blend(blue, white, 0.25)
save_image(mostly_blue, "blend_and_compare_mostly_blue.png")
save_image(mostly_white, "blend_and_compare_mostly_white.png")
show_image(mostly_blue)
show_image(mostly_white)

# diff(a, b) highlights where two same-sized images disagree, pixel by pixel.
difference = diff(blue, white)
save_image(difference, "blend_and_compare_diff.png")
show_image(difference)

print("blend_and_compare: wrote 3 output images\n")
