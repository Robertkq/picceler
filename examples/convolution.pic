

def main() : f64
{
    img = load_image("~/Pictures/cat.png")
    show_image(img)
    processed = work(img)
    show_image(processed)

    return 0
}

def work(imgx : image) : image
{
    kernel = [[-1, -1, -1],
            [-1,  8, -1],
            [-1, -1, -1]]
    convolution_img = convolution(imgx, kernel)

    return convolution_img
}
