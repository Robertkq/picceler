PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_BRIEF          = "A compiled DSL for image processing, built on MLIR"
OUTPUT_DIRECTORY       = "@CMAKE_SOURCE_DIR@/docs"
INPUT                  = @CMAKE_SOURCE_DIR@/README.md @CMAKE_SOURCE_DIR@/BUILD.md @CMAKE_SOURCE_DIR@/LANGUAGE.md @CMAKE_SOURCE_DIR@/LICENSE.md @CMAKE_SOURCE_DIR@/docs/compiler-internals.md @CMAKE_SOURCE_DIR@/docs/dialect-reference.md @CMAKE_SOURCE_DIR@/include @CMAKE_SOURCE_DIR@/src @CMAKE_BINARY_DIR@/tablegen
USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/README.md
RECURSIVE              = YES
EXTRACT_ALL            = YES
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
QUIET                  = YES