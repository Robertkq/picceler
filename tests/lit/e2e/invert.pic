
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: inverted once
# CHECK: inverted twice
# CHECK: invert: ok

def apply_invert(image img) -> image {
    return invert(img)
}

def main() -> int64 {
    image img = load_image("img/cat.png")
    print("loaded image\n")

    image inverted = apply_invert(img)
    print("inverted once\n")
    image restored = apply_invert(inverted)
    print("inverted twice\n")

    print("invert: ok\n")
    return 0
}
