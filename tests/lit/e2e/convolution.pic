
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: applied edge kernel
# CHECK: applied identity kernel
# CHECK: convolution: ok

def apply_edge_kernel(image img) -> image {
    kernel<3,3> k = [[-1, -1, -1],
                    [-1,  8, -1],
                    [-1, -1, -1]]
    image result = convolution(img, k)
    print("applied edge kernel\n")
    return result
}

def apply_identity_kernel(image img) -> image {
    kernel<3,3> k = [[0, 0, 0],
                    [0, 1, 0],
                    [0, 0, 0]]
    image result = convolution(img, k)
    print("applied identity kernel\n")
    return result
}

def main() -> int64 {
    image img = load_image("img/cat.png")
    print("loaded image\n")

    image edges = apply_edge_kernel(img)
    image identity = apply_identity_kernel(img)

    print("convolution: ok\n")
    return 0
}
