
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: convolution: ok

def main() -> int64
{
    img = load_image("img/cat.png")
    processed = work(img)

    print("convolution: ok\n")
    return 0
}

def work(imgx : image) -> image
{
    kernel = [[-1, -1, -1],
            [-1,  8, -1],
            [-1, -1, -1]]
    convolution_img = convolution(imgx, kernel)

    return convolution_img
}
