
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: applied small box_blur
# CHECK: applied large box_blur
# CHECK: applied runtime box_blur radius=4
# CHECK: box_blur: ok

def apply_small(img: image) -> image {
    result = box_blur(img, 3)
    print("applied small box_blur\n")
    return result
}

def apply_large(img: image) -> image {
    result = box_blur(img, 9)
    print("applied large box_blur\n")
    return result
}

# radius comes from a typed function parameter (not a literal), so it can't be folded to a
# compile-time constant -- box_blur used to require exactly that. See issue #117.
def apply_runtime(img: image, radius: f64) -> image {
    result = box_blur(img, radius)
    print("applied runtime box_blur radius={}\n", radius)
    return result
}

def main() -> int64 {
    img = load_image("img/cat.png")
    print("loaded image\n")
    small = apply_small(img)
    large = apply_large(img)
    runtime = apply_runtime(img, 4.0)

    print("box_blur: ok\n")
    return 0
}
