
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded and dilated img/cat.png
# CHECK: function: ok

def load_and_dilate(string path) -> image {
    image img = load_image(path)
    image dilated = dilate(img, 3)
    print("loaded and dilated {}\n", path)
    return dilated
}

def unused_helper(string path) {
    image img = load_image(path)
}

def main() -> int64 {
    image dilated = load_and_dilate("img/cat.png")

    print("function: ok\n")
    return 0
}
