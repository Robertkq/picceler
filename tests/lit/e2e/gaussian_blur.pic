
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: applied small gaussian_blur
# CHECK: applied large gaussian_blur
# CHECK: gaussian_blur: ok

def apply_small(image img) -> image {
    image result = gaussian_blur(img, 2)
    print("applied small gaussian_blur\n")
    return result
}

def apply_large(image img) -> image {
    image result = gaussian_blur(img, 6)
    print("applied large gaussian_blur\n")
    return result
}

def main() -> int64 {
    image img = load_image("img/cat.png")
    print("loaded image\n")
    image small = apply_small(img)
    image large = apply_large(img)

    print("gaussian_blur: ok\n")
    return 0
}
