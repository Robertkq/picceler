
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: applied small gaussian_blur
# CHECK: applied large gaussian_blur
# CHECK: applied runtime gaussian_blur radius=3
# CHECK: gaussian_blur: ok

def apply_small(img: image) -> image {
    result = gaussian_blur(img, 2)
    print("applied small gaussian_blur\n")
    return result
}

def apply_large(img: image) -> image {
    result = gaussian_blur(img, 6)
    print("applied large gaussian_blur\n")
    return result
}

# radius comes from a typed function parameter (not a literal), so it can't be folded to a
# compile-time constant -- gaussian_blur used to require exactly that. See issue #117.
def apply_runtime(img: image, radius: f64) -> image {
    result = gaussian_blur(img, radius)
    print("applied runtime gaussian_blur radius={}\n", radius)
    return result
}

def main() -> int64 {
    img = load_image("img/cat.png")
    print("loaded image\n")
    small = apply_small(img)
    large = apply_large(img)
    runtime = apply_runtime(img, 3.0)

    print("gaussian_blur: ok\n")
    return 0
}
