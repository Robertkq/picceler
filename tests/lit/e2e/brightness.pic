
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: brightness: ok

def main()
{
    img = load_image("img/cat.png")

    brightness_func_A(img)
    brightness_func_B(img)
    brightness_func_C(img)
    brightness_func_D(img)

    print("brightness: ok\n")
}

def brightness_func_A(img : image)
{
    a = brightness(img, 10)
    b = brightness(a, 20)
}

def brightness_func_B(img : image)
{
    a = brightness(img, 10)
    b = brightness(a, -10)
}

def brightness_func_C(img : image)
{
    a = brightness(img, 0)
}

def brightness_func_D(img : image)
{
    a = brightness(img, 10)
}
