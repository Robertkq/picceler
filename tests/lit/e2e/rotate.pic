
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: rotated to 90
# CHECK: rotated to 180
# CHECK: rotated to 270
# CHECK: rotated to 360
# CHECK: rotated runtime angle=90
# CHECK: rotate: ok

def rotate_90(img: image) -> image {
    return rotate(img, 90)
}

# angle comes from a typed function parameter (not a literal), so it can't be folded to a
# compile-time constant -- rotate used to require exactly that. See issue #117.
def rotate_runtime(img: image, angle: f64) -> image {
    result = rotate(img, angle)
    print("rotated runtime angle={}\n", angle)
    return result
}

def main() -> int64 {
    img = load_image("img/cat.png")
    print("loaded image\n")

    quarter = rotate_90(img)
    print("rotated to 90\n")
    half = rotate_90(quarter)
    print("rotated to 180\n")
    three_quarters = rotate_90(half)
    print("rotated to 270\n")
    full_circle = rotate_90(three_quarters)
    print("rotated to 360\n")

    runtime = rotate_runtime(img, 90.0)

    print("rotate: ok\n")
    return 0
}
