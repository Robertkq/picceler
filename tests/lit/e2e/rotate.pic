
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: rotated to 90
# CHECK: rotated to 180
# CHECK: rotated to 270
# CHECK: rotated to 360
# CHECK: rotated runtime angle=90
# CHECK: rotate: ok

def rotate_90(image img) -> image {
    return rotate(img, 90)
}

def rotate_runtime(image img, float64 angle) -> image {
    image result = rotate(img, angle)
    print("rotated runtime angle={}\n", angle)
    return result
}

def main() -> int64 {
    image img = load_image("img/cat.png")
    print("loaded image\n")

    image quarter = rotate_90(img)
    print("rotated to 90\n")
    image half = rotate_90(quarter)
    print("rotated to 180\n")
    image three_quarters = rotate_90(half)
    print("rotated to 270\n")
    image full_circle = rotate_90(three_quarters)
    print("rotated to 360\n")

    image runtime = rotate_runtime(img, 90.0)

    print("rotate: ok\n")
    return 0
}
