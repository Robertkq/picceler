
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: cropped top-left
# CHECK: cropped center
# CHECK: crop: ok

def apply_crop(image img, float64 x, float64 y, float64 width, float64 height) -> image {
    return crop(img, x, y, width, height)
}

def main() -> int64 {
    image img = load_image("img/cat.png")
    print("loaded image\n")

    image top_left = apply_crop(img, 0.0, 0.0, 100.0, 100.0)
    print("cropped top-left\n")
    image center = apply_crop(img, 30.0, 135.0, 335.0, 240.0)
    print("cropped center\n")

    print("crop: ok\n")
    return 0
}
