
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: dilated radius=3
# CHECK: dilated radius=3
# CHECK: dilate: ok

def apply_dilate(image img, float64 radius) -> image {
    image result = dilate(img, radius)
    print("dilated radius={}\n", radius)
    return result
}

def main() -> int64 {
    image cat = load_image("img/cat.png")
    print("loaded image\n")

    image once = apply_dilate(cat, 3.0)
    image twice = apply_dilate(once, 3.0)

    print("dilate: ok\n")
    return 0
}
