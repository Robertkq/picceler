
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: applied edge_detect
# CHECK: applied edge_detect
# CHECK: edge_detect: ok

def apply_edge_detect(img: image) -> image {
    result = edge_detect(img)
    print("applied edge_detect\n")
    return result
}

def main() -> int64 {
    img = load_image("img/cat.png")
    print("loaded image\n")

    edges = apply_edge_detect(img)
    edges_of_edges = apply_edge_detect(edges)

    print("edge_detect: ok\n")
    return 0
}
