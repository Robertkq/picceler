
# RUN: %picceler -o %t %s
# RUN: %t | FileCheck %s

# CHECK: loaded image
# CHECK: dilated radius=3
# CHECK: eroded radius=3
# CHECK: erode: ok

def apply_erode(image img, float64 radius) -> image {
    image result = erode(img, radius)
    print("eroded radius={}\n", radius)
    return result
}

def main() -> int64 {
    image cat = load_image("img/cat.png")
    print("loaded image\n")

    image dilated = dilate(cat, 3)
    print("dilated radius=3\n")
    image closed = apply_erode(dilated, 3.0)

    print("erode: ok\n")
    return 0
}
