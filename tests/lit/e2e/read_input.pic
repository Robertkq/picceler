
# RUN: %picceler -o %t %s
# RUN: printf "img/cat.png\n3\n" | %t | FileCheck %s

# CHECK: read_input: ok

def load_and_dilate(path: string, radius: f64) -> image {
    img = load_image(path)
    return dilate(img, radius)
}

def main() -> int64 {
    path = read_string("Please enter the path to your image:")
    value = read_number("Please enter the radius for DilateOp:")

    dilated_img = load_and_dilate(path, value)

    print("read_input: ok\n")
    return 0
}
