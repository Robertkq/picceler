
# RUN: %picceler -o %t %s
# RUN: printf "img/cat.png\n3\n" | %t | FileCheck %s

# CHECK: read_input: ok

def load_and_dilate(string path, float64 radius) -> image {
    image img = load_image(path)
    return dilate(img, radius)
}

def main() -> int64 {
    string path = read_string("Please enter the path to your image:")
    float64 value = read_number("Please enter the radius for DilateOp:")

    image dilated_img = load_and_dilate(path, value)

    print("read_input: ok\n")
    return 0
}
